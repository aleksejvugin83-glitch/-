        Book("Война и мир", "Лев Толстой", 1869, "978-5-17-123456-0", 1225, "Роман-эпопея"),
        Book("Маленький принц", "Антуан де Сент-Экзюпери", 1943, "978-5-699-12345-1", 96, "Притча"),
