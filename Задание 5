def main():
    """Основная функция программы"""
    # Создаем коллекцию книг
    library = LibraryCollection()
    
    # Создаем меню
    menu = Menu(library)
    
    # Запрашиваем у пользователя, хочет ли он создать демо-данные
    print("="*50)
    print("СИСТЕМА УПРАВЛЕНИЯ БИБЛИОТЕЧНОЙ КОЛЛЕКЦИЕЙ")
    print("="*50)
    
    demo_choice = input("Создать демонстрационную коллекцию книг? (да/нет): ").strip().lower()
    
    if demo_choice in ['да', 'д', 'yes', 'y']:
        create_sample_data(library)
    
    # Запускаем меню
    menu.run()

if __name__ == "__main__":
    main()
