// Класс для хранения списка студентов
class StudentList {
    private List<Student> students;
    
    public StudentList() {
        this.students = new ArrayList<>();
    }
    
    // Метод добавления нового студента
    public void addStudent(Student student) {
        students.add(student);
        System.out.println("Студент " + student.getLastName() + " " + 
                          student.getFirstName() + " добавлен в список.");
    }
    
    // Метод печати списка всех студентов
    public void printAllStudents() {
        System.out.println("\n=== СПИСОК ВСЕХ СТУДЕНТОВ ===");
        System.out.println("Всего студентов: " + students.size());
        System.out.println("==============================\n");
        
        if (students.isEmpty()) {
            System.out.println("Список студентов пуст.");
            return;
        }
        
        for (int i = 0; i < students.size(); i++) {
            System.out.println("Студент №" + (i + 1) + ":");
            students.get(i).printInfo();
        }
    }
    
    // Дополнительные методы для работы со списком
    
    // Печать студентов определенной формы обучения
    public void printStudentsByType(String type) {
        System.out.println("\n=== СТУДЕНТЫ (" + type + ") ===");
        int count = 0;
        
        for (Student student : students) {
            if (type.equals("Очное отделение") && student instanceof FullTimeStudent) {
                student.printInfo();
                count++;
            } else if (type.equals("Заочное отделение") && student instanceof PartTimeStudent) {
                student.printInfo();
                count++;
            } else if (type.equals("Целевое обучение") && student instanceof TargetedStudent) {
                student.printInfo();
                count++;
            }
        }
        
        if (count == 0) {
            System.out.println("Студентов с формой обучения '" + type + "' не найдено.");
        } else {
            System.out.println("Найдено студентов: " + count);
        }
    }
    
    // Поиск студента по номеру зачетной книжки
    public Student findStudentByRecordBook(String recordBookNumber) {
        for (Student student : students) {
            if (student.getRecordBookNumber().equals(recordBookNumber)) {
                return student;
            }
        }
        return null;
    }
    
    // Получение количества студентов
    public int getStudentCount() {
        return students.size();
    }
}
