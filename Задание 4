                          String group, String department, String discipline,
                          int mark, String teacherLastName,
                          String workplace, String position, double tuitionFee) {
        super(recordBookNumber, lastName, firstName, group, department,
              discipline, mark, teacherLastName);
        this.workplace = workplace;
        this.position = position;
        this.tuitionFee = tuitionFee;
    }
    
    public String getWorkplace() { return workplace; }
    public String getPosition() { return position; }
    public double getTuitionFee() { return tuitionFee; }
    
    public void setWorkplace(String workplace) { this.workplace = workplace; }
    public void setPosition(String position) { this.position = position; }
    public void setTuitionFee(double tuitionFee) { this.tuitionFee = tuitionFee; }
    
    @Override
    public void printInfo() {
