import java.util.ArrayList;
import java.util.List;
// Родительский класс Студент
class Student {
    protected String recordBookNumber;  // номер зачетной книжки
    protected String lastName;          // фамилия
    protected String firstName;         // имя
    protected String group;             // группа
    protected String department;        // кафедра
    protected String discipline;        // дисциплина
    protected int mark;                 // оценка
    protected String teacherLastName;   // фамилия преподавателя
    
    // Конструктор
    public Student(String recordBookNumber, String lastName, String firstName, 
                   String group, String department, String discipline, 
                   int mark, String teacherLastName) {
        this.recordBookNumber = recordBookNumber;
        this.lastName = lastName;
        this.firstName = firstName;
        this.group = group;
        this.department = department;
        this.discipline = discipline;
        this.mark = mark;
        this.teacherLastName = teacherLastName;
    }
    
    // Геттеры
    public String getRecordBookNumber() { return recordBookNumber; }
    public String getLastName() { return lastName; }
    public String getFirstName() { return firstName; }
    public String getGroup() { return group; }
    public String getDepartment() { return department; }
    public String getDiscipline() { return discipline; }
    public int getMark() { return mark; }
    public String getTeacherLastName() { return teacherLastName; }
    
    // Сеттеры
    public void setRecordBookNumber(String recordBookNumber) { this.recordBookNumber = recordBookNumber; }
    public void setLastName(String lastName) { this.lastName = lastName; }
    public void setFirstName(String firstName) { this.firstName = firstName; }
    public void setGroup(String group) { this.group = group; }
    public void setDepartment(String department) { this.department = department; }
    public void setDiscipline(String discipline) { this.discipline = discipline; }
    public void setMark(int mark) { this.mark = mark; }
    public void setTeacherLastName(String teacherLastName) { this.teacherLastName = teacherLastName; }
    
    // Метод для вывода информации
    public void printInfo() {
        System.out.println("Зачетная книжка: " + recordBookNumber);
        System.out.println("ФИО: " + lastName + " " + firstName);
        System.out.println("Группа: " + group);
        System.out.println("Кафедра: " + department);
        System.out.println("Дисциплина: " + discipline);
        System.out.println("Оценка: " + mark);
        System.out.println("Преподаватель: " + teacherLastName);
    }
}
// Дочерний класс Очное отделение
class FullTimeStudent extends Student {
    private int egeScore;             // балл ЕГЭ
    private double averageDiplomaScore; // средний балл аттестата
    
    public FullTimeStudent(String recordBookNumber, String lastName, String firstName,
                          String group, String department, String discipline,
                          int mark, String teacherLastName,
                          int egeScore, double averageDiplomaScore) {
        super(recordBookNumber, lastName, firstName, group, department, 
              discipline, mark, teacherLastName);
        this.egeScore = egeScore;
        this.averageDiplomaScore = averageDiplomaScore;
    }
    
    public int getEgeScore() { return egeScore; }
    public double getAverageDiplomaScore() { return averageDiplomaScore; }
    
    public void setEgeScore(int egeScore) { this.egeScore = egeScore; }
    public void setAverageDiplomaScore(double averageDiplomaScore) { this.averageDiplomaScore = averageDiplomaScore; }
    
    @Override
    public void printInfo() {
        super.printInfo();
        System.out.println("Форма обучения: Очное отделение");
        System.out.println("Балл ЕГЭ: " + egeScore);
        System.out.println("Средний балл аттестата: " + averageDiplomaScore);
        System.out.println("---------------------------");
    }
}
// Дочерний класс Заочное отделение
class PartTimeStudent extends Student {
