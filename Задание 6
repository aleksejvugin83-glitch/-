import java.util.Scanner;

public class StudentApp {
    private StudentManager manager;
    private Scanner scanner;
    
    public StudentApp() {
        manager = new StudentManager();
        scanner = new Scanner(System.in);
    }
    
    public void run() {
        boolean running = true;
        
        while (running) {
            printMenu();
            System.out.print("Выберите действие: ");
            
            try {
                int choice = Integer.parseInt(scanner.nextLine());
                
                switch (choice) {
                    case 1 -> addStudent();
                    case 2 -> showAllStudents();
                    case 3 -> saveToFile();
                    case 4 -> loadFromFile();
                    case 5 -> saveToSpecificFile();
                    case 6 -> loadFromSpecificFile();
                    case 7 -> showCurrentFile();
                    case 8 -> clearCollection();
                    case 0 -> {
                        System.out.println("Выход из программы...");
                        running = false;
                    }
                    default -> System.out.println("Неверный выбор. Попробуйте снова.");
                }
            } catch (NumberFormatException e) {
                System.out.println("Пожалуйста, введите число.");
            }
        }
        
        scanner.close();
    }
    
    private void printMenu() {
        System.out.println("\n=== МЕНЮ УПРАВЛЕНИЯ СТУДЕНТАМИ ===");
        System.out.println("1. Добавить студента");
        System.out.println("2. Показать всех студентов");
        System.out.println("3. Сохранить в текущий файл");
        System.out.println("4. Загрузить из текущего файла");
        System.out.println("5. Сохранить в указанный файл");
        System.out.println("6. Загрузить из указанного файла");
        System.out.println("7. Показать текущий файл");
        System.out.println("8. Очистить коллекцию");
        System.out.println("0. Выход");
        System.out.println("=================================");
    }
    
    private void addStudent() {
        try {
            System.out.print("Введите ID студента: ");
            int id = Integer.parseInt(scanner.nextLine());
            
            System.out.print("Введите имя студента: ");
            String name = scanner.nextLine();
            
            System.out.print("Введите возраст студента: ");
            int age = Integer.parseInt(scanner.nextLine());
            
            Student student = new Student(id, name, age);
            manager.addStudent(student);
            System.out.println("Студент успешно добавлен!");
            
        } catch (NumberFormatException e) {
            System.out.println("Ошибка: неверный формат числа.");
        }
    }
    
    private void showAllStudents() {
        System.out.println("\n=== СПИСОК СТУДЕНТОВ ===");
        var students = manager.getAllStudents();
        
        if (students.isEmpty()) {
            System.out.println("Список студентов пуст.");
        } else {
            for (Student student : students) {
                System.out.println(student);
            }
        }
        System.out.println("========================");
    }
    
    private void saveToFile() {
        if (manager.save()) {
            System.out.println("Данные сохранены успешно.");
        } else {
            System.out.println("Не удалось сохранить данные.");
        }
    }
    
    private void loadFromFile() {
        if (manager.loadFromFile(manager.getCurrentFileName())) {
            System.out.println("Данные загружены успешно.");
        } else {
            System.out.println("Не удалось загрузить данные.");
        }
    }
    
    private void saveToSpecificFile() {
        System.out.print("Введите имя файла для сохранения: ");
        String fileName = scanner.nextLine();
        
        if (manager.saveToFile(fileName)) {
            System.out.println("Данные сохранены в файл: " + fileName);
        } else {
            System.out.println("Не удалось сохранить данные.");
        }
    }
    
    private void loadFromSpecificFile() {
        System.out.print("Введите имя файла для загрузки: ");
        String fileName = scanner.nextLine();
        
        if (manager.loadFromFile(fileName)) {
            System.out.println("Данные загружены из файла: " + fileName);
        } else {
            System.out.println("Не удалось загрузить данные.");
        }
    }
    
    private void showCurrentFile() {
        System.out.println("Текущий файл: " + manager.getCurrentFileName());
    }
    
    private void clearCollection() {
        System.out.print("Вы уверены, что хотите очистить коллекцию? (y/n): ");
        String answer = scanner.nextLine();
        
        if (answer.equalsIgnoreCase("y")) {
            manager.clear();
            System.out.println("Коллекция очищена.");
        } else {
            System.out.println("Очистка отменена.");
        }
    }
    
    public static void main(String[] args) {
        StudentApp app = new StudentApp();
        app.run();
    }
}

