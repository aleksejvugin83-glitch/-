import java.io.*;
import java.util.ArrayList;
import java.util.List;

public class StudentManager {
    private List<Student> students;
    private String currentFileName;
    
    public StudentManager() {
        students = new ArrayList<>();
        currentFileName = "students.txt";
    }
    
    // Добавление студента
    public void addStudent(Student student) {
        students.add(student);
    }
    
    // Получение всех студентов
    public List<Student> getAllStudents() {
        return new ArrayList<>(students);
    }
    
    // Сохранение в текстовый файл
    public boolean saveToFile(String fileName) {
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(fileName))) {
            for (Student student : students) {
                writer.write(student.toFileString());
                writer.newLine();
            }
            currentFileName = fileName;
            System.out.println("Данные успешно сохранены в файл: " + fileName);
            return true;
        } catch (IOException e) {
            System.err.println("Ошибка при сохранении в файл: " + e.getMessage());
            return false;
        }
    }
    
    // Загрузка из текстового файла
    public boolean loadFromFile(String fileName) {
        List<Student> loadedStudents = new ArrayList<>();
        
        try (BufferedReader reader = new BufferedReader(new FileReader(fileName))) {
            String line;
            int lineNumber = 0;
            
            while ((line = reader.readLine()) != null) {
                lineNumber++;
                line = line.trim();
                
                // Пропускаем пустые строки
                if (line.isEmpty()) {
                    continue;
                }
                
                try {
                    Student student = Student.fromFileString(line);
                    loadedStudents.add(student);
                } catch (Exception e) {
                    System.err.println("Ошибка в строке " + lineNumber + ": " + e.getMessage());
                    return false;
                }
            }
            
            // Если загрузка прошла успешно, заменяем текущую коллекцию
            students = loadedStudents;
            currentFileName = fileName;
            System.out.println("Данные успешно загружены из файла: " + fileName);
            return true;
            
        } catch (FileNotFoundException e) {
            System.err.println("Файл не найден: " + fileName);
            return false;
        } catch (IOException e) {
            System.err.println("Ошибка при чтении файла: " + e.getMessage());
            return false;
        }
    }
    
    // Сохранение в текущий файл
    public boolean save() {
        return saveToFile(currentFileName);
    }
    
    // Получение текущего имени файла
    public String getCurrentFileName() {
        return currentFileName;
    }
    
    // Очистка коллекции
    public void clear() {
        students.clear();
    }
}

