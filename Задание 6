import java.io.*;
import java.util.ArrayList;
import java.util.List;

public class StudentBinaryManager {
    private List<Student> students;
    
    public StudentBinaryManager() {
        students = new ArrayList<>();
    }
    
    // Сохранение в бинарный файл
    public boolean saveBinary(String fileName) {
        try (ObjectOutputStream oos = new ObjectOutputStream(
                new FileOutputStream(fileName))) {
            oos.writeObject(students);
            System.out.println("Данные сохранены в бинарный файл: " + fileName);
            return true;
        } catch (IOException e) {
            System.err.println("Ошибка при сохранении: " + e.getMessage());
            return false;
        }
    }
    
    // Загрузка из бинарного файла
    @SuppressWarnings("unchecked")
    public boolean loadBinary(String fileName) {
        try (ObjectInputStream ois = new ObjectInputStream(
                new FileInputStream(fileName))) {
            students = (List<Student>) ois.readObject();
            System.out.println("Данные загружены из бинарного файла: " + fileName);
            return true;
        } catch (FileNotFoundException e) {
            System.err.println("Файл не найден: " + fileName);
            return false;
        } catch (IOException | ClassNotFoundException e) {
            System.err.println("Ошибка при загрузке: " + e.getMessage());
            return false;
        }
    }
}




